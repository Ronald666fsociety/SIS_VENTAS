{
  "name": "app",
  "version": "0.0.1",
  "description": "A Quasar Project",
  "productName": "Quasar App",
  "author": "Ronald Anderson <ronald.anderson@gmail.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "dev:cliente": "cross-env APP_TARGET=cliente quasar dev",
    "dev:negocio": "cross-env APP_TARGET=negocio quasar dev",
    "build": "quasar build",
    "build:cliente": "cross-env APP_TARGET=cliente quasar build",
    "build:negocio": "cross-env APP_TARGET=negocio quasar build",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@quasar/extras": "^2.1.0",
    "axios": "^1.21.1",
    "leaflet": "^1.9.4",
    "pinia": "^4.0.2",
    "quasar": "^2.35.4",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.10.4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.19.11",
    "autoprefixer": "^10.4.27",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.8",
    "typescript": "^6.0.0",
    "vue-tsc": "^3.3.3"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
